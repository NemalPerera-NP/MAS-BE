# Copy to /etc/hvac-mas/hvac-mas.env on the VM and replace every placeholder.
STORAGE=mongo
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/hvac_mas?retryWrites=true&w=majority
MONGODB_DATABASE=hvac_mas
MONGODB_TTL_SECONDS=7200
MONGODB_TELEMETRY_COLLECTION=hvac_telemetry
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app
DEPLOYMENT_MODE=hosted
# Generate each token separately with openssl rand -hex 32.
RUNTIME_TOKEN=REPLACE_WITH_RUNTIME_TOKEN
EVALUATOR_TOKEN=REPLACE_WITH_EVALUATOR_TOKEN
STEP_INTERVAL=2
DECISION_TIMEOUT=30
AGENT_REPLY_TIMEOUT=5
HEARTBEAT_TIMEOUT=10
LOG_LEVEL=INFO
XMPP_EMBEDDED=true
XMPP_DOMAIN=localhost
XMPP_PORT=5222
