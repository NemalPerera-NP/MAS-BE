# MongoDB Change Streams require an Atlas cluster or another replica set.
STORAGE=mongo
# Put your private Atlas connection string in .env; do not commit it.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/...
MONGODB_DATABASE=hvac_mas
MONGODB_TTL_SECONDS=7200
# Per-operation deadline, including history cursor reads on slower connections.
MONGODB_OPERATION_TIMEOUT_MS=30000
MONGODB_TELEMETRY_COLLECTION=hvac_telemetry
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local loopback demo. For hosted mode set both tokens to distinct values
# generated with openssl rand -hex 32 and set DEPLOYMENT_MODE=hosted.
DEPLOYMENT_MODE=local
# RUNTIME_TOKEN=
# EVALUATOR_TOKEN=
STEP_INTERVAL=2
DECISION_TIMEOUT=30
AGENT_REPLY_TIMEOUT=5
HEARTBEAT_TIMEOUT=10
LOG_LEVEL=INFO
XMPP_EMBEDDED=true
XMPP_DOMAIN=localhost
XMPP_PORT=5222
# For an external XMPP server, provision all JIDs and set XMPP_PASSWORD.
